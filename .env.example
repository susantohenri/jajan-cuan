# ==============================================================================
# Jajan Cuan — Environment Variables Template
# Salin file ini menjadi '.env' dan masukkan kredensial Anda:
# cp .env.example .env
# ==============================================================================

# 1. Cloudflare Workers AI (REKOMENDASI GRATIS - 10.000 Neurons / Hari)
# Menggunakan model FLUX.1-schnell (@cf/black-forest-labs/flux-1-schnell) resolusi 1024x1024 px
# Dapatkan Token di: https://dash.cloudflare.com -> My Profile -> API Tokens -> Template "Workers AI"
# Dapatkan Account ID di: Dashboard Cloudflare -> Sidebar kanan / URL browser
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Google AI Studio / Gemini API (OPSIONAL - Membutuhkan Paid Tier)
# Model: gemini-3.1-flash-image / gemini-2.5-flash-image
# Dapatkan di: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
