{
  "rules": {
    "posts": {
      ".read": true,
      ".write": false,
      ".indexOn": ["published", "category"]
    },
    "waitlist": {
      ".read": false,
      ".write": true,
      "$pushId": {
        ".validate": "newData.hasChildren(['contact', 'type', 'created_at'])"
      }
    }
  }
}
